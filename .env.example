# Purser configuration (copy to .env; .env is gitignored).
# 12-factor env vars, PURSER_-prefixed, DATABASE_URL fallback — house style.

# --- Core ---
PURSER_ADDR=:4006
# Shared construct-server Postgres 16 (purser DB + role — see construct-server db/init-db.sh).
PURSER_DATABASE_URL=postgres://purser_user:CHANGE_ME@postgres:5432/purser?sslmode=disable
# Bearer token protecting the HTTP API. Leave empty ONLY if you rely on
# construct_net/Tailscale isolation (a startup warning is logged).
PURSER_API_TOKEN=

# --- Switchyard connector ---
# Internal API base on construct_net (not the public tunnel host).
PURSER_SWITCHYARD_BASE_URL=http://switchyard:4002
# Switchyard token (sw_…) owned by an agent user or owner-human — the create-user
# and mint-token handlers require instance-admin as well as scope. Needs exactly
# `users:manage` (create user + mint token) and `projects:manage` (project
# membership); the project/user reads Purser does are visibility-filtered, not
# scope-gated, so no read scope is required. Don't use `admin`, and don't reuse
# the instance BOOTSTRAP_TOKEN — a dedicated agent user keeps provisioning
# traffic attributable and independently revocable (PRSR-3).
PURSER_SWITCHYARD_TOKEN=
# Public login URL shown in the credential block.
PURSER_SWITCHYARD_URL=https://switchyard.zerogravity.industries

# --- Cloudflare Access connector (adds people to SSO) ---
# When these are unset, `--to cloudflare` prints the manual dashboard step
# instead of granting access via the API.
# One API token covers every Cloudflare call Purser makes. Real scopes, which
# had drifted from what this file used to claim (PRSR-11):
#
#   Account > Access: Organizations, Identity Providers, and Groups : Edit
#   Account > Access: Apps                                          : Edit
#   Account > Access: Policies                                      : Edit
#   Account > Cloudflare Tunnel                                     : Edit
#   Zone    > DNS                                                   : Edit
#             ^ scoped to the one zone below, not "All zones"
#
# Only the first is needed for `invite`; the rest are for service spin-up
# (PRSR-22). Edit subsumes Read, so there is no separate Read scope to grant.
# Watch the names: "Account DNS Settings" and "Zone DNS Settings" are both
# *settings*, and "DNS Views" is Internal DNS — the one that grants records is
# the plain "DNS" group at *Zone* scope. "Cloudflare Tunnel" is still called
# "Argo Tunnel" in older docs.
PURSER_CF_API_TOKEN=
PURSER_CF_ACCOUNT_ID=
# The shared Access group every app policy allows (recommended model — one grant
# covers all tunneled apps). Create it in the Zero Trust dashboard, then set its id.
PURSER_CF_ACCESS_GROUP_ID=
PURSER_CF_ACCESS_GROUP_NAME=zerogravity-members
PURSER_CF_TEAM_DOMAIN=zero-gravity-industries.cloudflareaccess.com
PURSER_CF_APPS_NOTE=Switchyard and the other tunneled Construct apps

# Service spin-up coordinates (PRSR-22). The zone id is what the DNS provisioner
# creates records in (PRSR-28); the Access and tunnel provisioners aren't built
# yet (PRSR-29/30), and nothing wires a spin-up command until PRSR-31. Unset is
# fine and changes nothing about `invite` — the DNS step reports `unavailable`.
# Zone id: the zone's Overview pane in the dashboard, right-hand API section.
PURSER_CF_ZONE_ID=
# Tunnel id: Zero Trust > Networks > Tunnels, or `GET /accounts/{acct}/cfd_tunnel`.
# On construct-server this is the same value as CLOUDFLARE_TUNNEL_ID.
#
# This is the `prod` tunnel specifically. A ServiceSpec names a ref (prod|dev)
# and Purser resolves it here, because the account also runs a construct-dev
# tunnel; only prod is wired, and a dev spec refuses rather than quietly landing
# in prod's shared ingress config (PRSR-33).
PURSER_CF_TUNNEL_ID=

# Cloudflare's App Launcher — the page listing every Access-gated app a person
# can reach. The credential block leads with it, but only for invites that
# actually granted Access (an Argosy-only invitee would get an empty page).
# Defaults to https:// + PURSER_CF_TEAM_DOMAIN, so leave it unset unless the
# launcher lives somewhere else.
PURSER_LAUNCHER_URL=

# --- Lyceum connector (ebook reader; PRSR-6) ---
# Unset => `--to lyceum` is registered but Unavailable. Requires the lyceum
# service to run with LYCEUM_AUTH=true, and an owner *session* token here
# (obtain once: `lyceum mint-token` on the host → redeem via POST /auth/session;
# the resulting session token never expires). Not a LYCEUM_API_TOKENS entry.
PURSER_LYCEUM_BASE_URL=http://lyceum:4005
PURSER_LYCEUM_OWNER_TOKEN=
# Public app URL for the credential block's redemption note (optional; Lyceum
# isn't tunnelled yet).
PURSER_LYCEUM_URL=

# --- Argosy connector (media server; PRSR-13) ---
# Unset => `--to argosy` is registered but Unavailable. Must equal the argosy
# service's ARGOSY_PROVISION_TOKEN — argosy registers POST /api/v1/admin/accounts
# only when that env is set, and 404s the route otherwise.
PURSER_ARGOSY_BASE_URL=http://argosy:8096
PURSER_ARGOSY_PROVISION_TOKEN=
# Public sign-in URL for the credential block. Argosy is on the direct path
# (Traefik, no Cloudflare Access), so the invitee just signs in with email +
# the one-time password and pairs devices from there.
PURSER_ARGOSY_URL=https://argosy.zerogravity.industries

# --- Onboarding bundles (PRSR-12) ---
# A bundle is a named service set, so a standard onboard is `--bundle media`
# rather than a hand-assembled --to list. Defining ANY bundle here replaces the
# built-in set wholesale (no merging), so list them all if you override.
#
# Built-in defaults, used when nothing below is set:
#   media = cloudflare,lyceum,argosy              (non-technical household)
#   all   = cloudflare,switchyard,lyceum,argosy   (people who'd want Switchyard)
#
# Cloudflare belongs in both: Lyceum sits behind the Access gate, so without the
# Access grant the person can't reach it at all. Argosy is on the direct path
# and needs no grant — the overlap is free.
# PURSER_BUNDLE_MEDIA=cloudflare,lyceum,argosy
# PURSER_BUNDLE_ALL=cloudflare,switchyard,lyceum,argosy
#
# Optional per-bundle Switchyard project grants (KEY:ROLE, '*' = every project).
# Defaults to *:user — Switchyard's "User" project level. Note this is the
# project role (viewer|user|editor|admin), NOT the instance role
# (member|owner): a bundle grants project access without escalating privilege.
# An explicit --projects on the invite always overrides this.
# PURSER_BUNDLE_ALL_PROJECTS=*:user
#
# Bundle used when an invite names neither --to nor --bundle. Defaults to the
# smaller `media` set, so an unqualified invite can't hand out Switchyard.
# PURSER_DEFAULT_BUNDLE=media

# --- Email delivery (optional; enables --deliver email) ---
PURSER_SMTP_HOST=
PURSER_SMTP_PORT=587
PURSER_SMTP_USERNAME=
PURSER_SMTP_PASSWORD=
PURSER_SMTP_FROM=purser@zerogravity.industries
PURSER_SMTP_TLS=starttls
